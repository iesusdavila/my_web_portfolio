---
import feather from 'feather-icons';

export interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className = '' } = Astro.props;
const icon = (feather.icons as Record<string, { toSvg: (attrs: Record<string, string | number>) => string }>)[name];
const svg = icon
  ? icon.toSvg({ width: size, height: size, 'stroke-width': 1.75, 'aria-hidden': 'true', focusable: 'false', class: `shrink-0 ${className}` })
  : '';
---

<Fragment set:html={svg} />
