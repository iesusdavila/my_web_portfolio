---
import DarkModeToggle from './DarkModeToggle.astro';
import Icon from './Icon.astro';

const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/papers', label: 'Papers' },
  { href: '/awards', label: 'Awards' },
  { href: '/cv', label: 'CV' },
  { href: '/contact', label: 'Contact' },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => current === href;
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/95 backdrop-blur-sm">
  <div class="page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 rounded-md" aria-label="Iesus Davila, home">
      <img src="/assets/logo.svg" alt="" width="32" height="32" class="h-8 w-8" />
      <span class="font-display text-lg font-semibold">Iesus Davila</span>
    </a>

    <div class="flex items-center gap-2">
      <nav aria-label="Main" class="mr-2 hidden items-center gap-1 md:flex">
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class:list={[
                'nav-link rounded-md px-3 py-2 text-[0.9375rem] transition-colors hover:text-ink',
                isCurrent(link.href) ? 'font-medium text-ink' : 'text-muted',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <DarkModeToggle />

      <button
        type="button"
        id="menu-button"
        class="icon-btn md:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span data-menu-open class="inline-flex"><Icon name="menu" size={20} /></span>
        <span data-menu-close class="hidden"><Icon name="x" size={20} /></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Main" class="hidden border-t border-line bg-paper md:hidden">
    <ul class="page divide-y divide-line py-1">
      <li>
        <a
          href="/"
          aria-current={current === '/' ? 'page' : undefined}
          class:list={['flex min-h-[3rem] items-center justify-between text-base', current === '/' ? 'font-medium text-ink' : 'text-muted']}
        >
          Home
        </a>
      </li>
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class:list={[
                'flex min-h-[3rem] items-center justify-between text-base',
                isCurrent(link.href) ? 'font-medium text-ink' : 'text-muted',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');

  if (button && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      button.setAttribute('aria-expanded', String(open));
      button.querySelector('[data-menu-open]')?.classList.toggle('hidden', open);
      button.querySelector('[data-menu-open]')?.classList.toggle('inline-flex', !open);
      button.querySelector('[data-menu-close]')?.classList.toggle('hidden', !open);
      button.querySelector('[data-menu-close]')?.classList.toggle('inline-flex', open);
    };

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
    window.matchMedia('(min-width: 768px)').addEventListener('change', () => setOpen(false));
  }
</script>
