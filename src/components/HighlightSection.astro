---
export interface Props {
  title: string;
  description?: string;
  linkText?: string;
  linkUrl?: string;
  id?: string;
}

const { title, description, linkText, linkUrl, id } = Astro.props;
---

<section id={id} class="section">
  <div class="page">
    <div class="mb-8 flex flex-col gap-3 sm:mb-10 sm:flex-row sm:items-end sm:justify-between sm:gap-8">
      <div>
        <h2 class="section-title">{title}</h2>
        {description && <p class="mt-2 max-w-[40rem] text-muted">{description}</p>}
      </div>
      {
        linkText && linkUrl && (
          <a href={linkUrl} class="text-link shrink-0 text-[0.9375rem]">
            {linkText}
          </a>
        )
      }
    </div>

    <slot />
  </div>
</section>
