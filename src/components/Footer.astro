---
import personalInfo from '../data/info.json';
import Icon from './Icon.astro';

const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/papers', label: 'Papers' },
  { href: '/awards', label: 'Awards' },
  { href: '/cv', label: 'CV' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="border-t border-line bg-surface">
  <div class="page flex flex-col gap-8 py-10 md:flex-row md:items-start md:justify-between">
    <div>
      <p class="font-display text-lg font-semibold">{personalInfo.name}</p>
      <p class="mt-1 text-[0.9375rem] text-muted">{personalInfo.location}</p>
      <a href={`mailto:${personalInfo.email}`} class="text-link mt-3 text-[0.9375rem]">{personalInfo.email}</a>
    </div>

    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-1">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="inline-flex min-h-[2.75rem] items-center text-[0.9375rem] text-muted transition-colors hover:text-ink">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="flex gap-2">
      {
        personalInfo.socialLinks.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label={link.name}>
              <Icon name={link.icon} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="border-t border-line">
    <p class="page py-4 text-sm text-muted">&copy; {new Date().getFullYear()} {personalInfo.name}</p>
  </div>
</footer>
