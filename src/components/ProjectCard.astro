---
import Icon from './Icon.astro';

export interface Props {
  title: string;
  description: string;
  image: string;
  technologies: string[];
  github?: string;
  demo?: string;
  eager?: boolean;
}

const { title, description, image, technologies, github, demo, eager = false } = Astro.props;
const isVideo = demo ? /youtu\.?be/.test(demo) : false;
---

<article class="panel flex h-full flex-col overflow-hidden transition-colors hover:border-line-strong">
  <img
    src={image}
    alt=""
    width="1280"
    height="800"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    class="aspect-[16/10] w-full border-b border-line bg-sunken object-cover dark:brightness-90"
  />

  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-xl leading-snug">{title}</h3>

    <div class="mt-2" data-expandable>
      <p class="line-clamp-4 text-[0.9375rem] leading-relaxed text-muted" data-expandable-text>{description}</p>
      <button
        type="button"
        hidden
        aria-expanded="false"
        class="mt-1 inline-flex min-h-[2rem] items-center text-sm font-medium text-ink underline decoration-line-strong underline-offset-4 hover:decoration-accent"
        data-expandable-toggle
      >
        Show more
      </button>
    </div>

    <ul class="mt-4 flex flex-wrap gap-1.5">
      {technologies.map((tech) => <li class="chip">{tech}</li>)}
    </ul>

    {
      (github || demo) && (
        <div class="mt-auto flex flex-wrap gap-x-5 gap-y-1 pt-5">
          {github && (
            <a href={github} target="_blank" rel="noopener noreferrer" class="text-link min-h-[2.75rem] text-[0.9375rem]">
              <Icon name="github" size={16} />
              Code
              <span class="sr-only">for {title}</span>
            </a>
          )}
          {demo && (
            <a href={demo} target="_blank" rel="noopener noreferrer" class="text-link min-h-[2.75rem] text-[0.9375rem]">
              <Icon name={isVideo ? 'play-circle' : 'external-link'} size={16} />
              {isVideo ? 'Video' : 'Live demo'}
              <span class="sr-only">of {title}</span>
            </a>
          )}
        </div>
      )
    }
  </div>
</article>

<script>
  const setup = () => {
    document.querySelectorAll<HTMLElement>('[data-expandable]').forEach((block) => {
      const text = block.querySelector<HTMLElement>('[data-expandable-text]');
      const toggle = block.querySelector<HTMLButtonElement>('[data-expandable-toggle]');
      if (!text || !toggle) return;

      if (toggle.getAttribute('aria-expanded') !== 'true') {
        toggle.hidden = text.scrollHeight <= text.clientHeight + 1;
      }

      if (toggle.dataset.bound) return;
      toggle.dataset.bound = 'true';
      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        text.classList.toggle('line-clamp-4', expanded);
        toggle.setAttribute('aria-expanded', String(!expanded));
        toggle.textContent = expanded ? 'Show more' : 'Show less';
      });
    });
  };

  setup();
  window.addEventListener('resize', setup);
  document.fonts?.ready.then(setup);
</script>
