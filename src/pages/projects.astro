---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';

const filters = [
  { key: 'all', label: 'All' },
  { key: 'computer-vision', label: 'Computer vision' },
  { key: 'llm', label: 'LLMs' },
  { key: 'agents', label: 'AI agents' },
  { key: 'ros', label: 'ROS / ROS 2' },
].filter((filter) => filter.key === 'all' || projects.some((project) => project.categories.includes(filter.key)));
---

<Layout title="Projects | Iesus Davila">
  <PageHeader
    title="Projects"
    description="Computer vision, language models, agents and robotics projects, each with its code and results."
  />

  <div class="page pb-16 sm:pb-24">
    <div class="mb-6 flex flex-col gap-3 sm:mb-8 sm:flex-row sm:items-center sm:justify-between">
      <div class="-mx-5 flex gap-2 overflow-x-auto px-5 pb-1 sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0 sm:pb-0" role="group" aria-label="Filter projects by topic">
        {
          filters.map((filter) => (
            <button
              type="button"
              data-filter={filter.key}
              aria-pressed={filter.key === 'all' ? 'true' : 'false'}
              class="inline-flex min-h-[2.75rem] shrink-0 items-center rounded-md border border-line-strong bg-surface px-3.5 text-[0.9375rem] text-ink transition-colors hover:border-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-paper"
            >
              {filter.label}
            </button>
          ))
        }
      </div>
      <p id="project-count" class="shrink-0 text-[0.9375rem] text-muted" aria-live="polite">{projects.length} projects</p>
    </div>

    <ul id="project-grid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project, index) => (
          <li data-categories={project.categories.join(',')}>
            <ProjectCard
              title={project.title}
              description={project.description}
              image={project.image}
              technologies={project.technologies}
              github={project.github}
              demo={project.demo}
              eager={index < 3}
            />
          </li>
        ))
      }
    </ul>

    <p id="no-results" hidden class="panel p-6 text-muted">No projects in this topic yet. Choose another filter.</p>
  </div>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('#project-grid > li');
  const count = document.getElementById('project-count');
  const empty = document.getElementById('no-results');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'all';
      buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));

      let visible = 0;
      cards.forEach((card) => {
        const categories = (card.dataset.categories ?? '').split(',');
        const show = filter === 'all' || categories.includes(filter);
        card.hidden = !show;
        if (show) visible += 1;
      });

      if (count) count.textContent = `${visible} ${visible === 1 ? 'project' : 'projects'}`;
      if (empty) empty.hidden = visible > 0;
      window.dispatchEvent(new Event('resize'));
    });
  });
</script>
