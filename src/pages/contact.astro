---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import ContactDetails from '../components/ContactDetails.astro';
---

<Layout title="Contact | Iesus Davila">
  <PageHeader
    title="Get in touch"
    description="Have a project idea or a research proposal? Write to me and we can talk about working together."
  />

  <div class="page grid gap-5 pb-16 sm:pb-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]">
    <section class="panel order-2 p-5 sm:p-7 lg:order-1" aria-labelledby="contact-details">
      <h2 id="contact-details" class="mb-5 text-xl">Contact details</h2>
      <ContactDetails />
    </section>

    <section class="panel order-1 p-5 sm:p-7 lg:order-2" aria-labelledby="contact-form-title">
      <h2 id="contact-form-title" class="mb-5 text-xl">Send a message</h2>
      <ContactForm />
    </section>
  </div>
</Layout>
