---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import PaperItem from '../components/PaperItem.astro';
import papers from '../data/papers.json';
---

<Layout title="Papers | Iesus Davila">
  <PageHeader title="Papers" description="Peer-reviewed publications in robotics and artificial intelligence." />

  <div class="page space-y-4 pb-16 sm:pb-24">
    {
      papers.map((paper) => (
        <PaperItem title={paper.title} journal={paper.journal} date={paper.date} authors={paper.authors} doi={paper.doi} />
      ))
    }
    {papers.length === 0 && <p class="panel p-6 text-muted">No papers published yet.</p>}
  </div>
</Layout>
