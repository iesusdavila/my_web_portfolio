---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import AwardItem from '../components/AwardItem.astro';
import awards from '../data/awards.json';
---

<Layout title="Awards | Iesus Davila">
  <PageHeader title="Awards and recognition" description="Awards, reviewer invitations and certifications in robotics and AI." />

  <div class="page space-y-4 pb-16 sm:pb-24">
    {
      awards.map((award) => (
        <AwardItem
          title={award.title}
          organization={award.organization}
          date={award.date}
          description={award.description}
          certificate={award.certificate}
        />
      ))
    }
    {awards.length === 0 && <p class="panel p-6 text-muted">No awards listed yet.</p>}
  </div>
</Layout>
