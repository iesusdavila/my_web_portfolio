---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import personalInfo from '../data/info.json';

const roles = personalInfo.title.split('|').map((part) => part.trim()).filter(Boolean);
---

<Layout title="CV | Iesus Davila">
  <div class="page pb-16 pt-10 sm:pb-24 sm:pt-16">
    <header class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-[2.25rem] leading-[1.1] sm:text-[3rem]">{personalInfo.name}</h1>
        <p class="mt-2 font-display text-xl font-semibold text-accent">{roles.join(', ')}</p>
        <ul class="mt-4 flex flex-col gap-x-6 gap-y-1.5 text-[0.9375rem] text-muted sm:flex-row sm:flex-wrap">
          <li class="flex items-center gap-2">
            <Icon name="mail" size={16} />
            <a href={`mailto:${personalInfo.email}`} class="break-all hover:text-ink">{personalInfo.email}</a>
          </li>
          <li class="flex items-center gap-2">
            <Icon name="phone" size={16} />
            <a href={`tel:${personalInfo.phone.replace(/\s+/g, '')}`} class="hover:text-ink">{personalInfo.phone}</a>
          </li>
          <li class="flex items-center gap-2">
            <Icon name="map-pin" size={16} />
            {personalInfo.location}
          </li>
        </ul>
      </div>
      <a href={personalInfo.cvDownloadLink} target="_blank" rel="noopener noreferrer" class="btn-primary shrink-0">
        <Icon name="download" size={16} />
        Download CV (PDF)
      </a>
    </header>

    <div class="panel mt-10 divide-y divide-line">
      <section class="cv-row" aria-labelledby="cv-summary">
        <h2 id="cv-summary" class="cv-heading">Summary</h2>
        <p class="max-w-[44rem] leading-relaxed">{personalInfo.bio}</p>
      </section>

      <section class="cv-row" aria-labelledby="cv-experience">
        <h2 id="cv-experience" class="cv-heading">Experience</h2>
        <ol class="space-y-8">
          {
            personalInfo.experience.map((job) => (
              <li>
                <div class="flex flex-col gap-x-6 gap-y-0.5 sm:flex-row sm:items-baseline sm:justify-between">
                  <div>
                    <h3 class="text-lg leading-snug">{job.position}</h3>
                    <p class="font-medium">{job.company}</p>
                  </div>
                  <p class="shrink-0 text-[0.9375rem] text-muted">{job.years}</p>
                </div>
                <ul class="mt-2 max-w-[44rem] list-disc space-y-1 pl-5 text-[0.9375rem] leading-relaxed text-muted marker:text-line-strong">
                  {job.responsibilities.map((item) => <li>{item}</li>)}
                </ul>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="cv-row" aria-labelledby="cv-education">
        <h2 id="cv-education" class="cv-heading">Education</h2>
        <ol class="space-y-6">
          {
            personalInfo.education.map((item) => (
              <li>
                <div class="flex flex-col gap-x-6 gap-y-0.5 sm:flex-row sm:items-baseline sm:justify-between">
                  <div>
                    <h3 class="text-lg leading-snug">{item.degree}</h3>
                    <p class="font-medium">{item.institution}</p>
                  </div>
                  <p class="shrink-0 text-[0.9375rem] text-muted">{item.year}</p>
                </div>
                <p class="mt-1 text-[0.9375rem] text-muted">{item.description}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="cv-row" aria-labelledby="cv-skills">
        <h2 id="cv-skills" class="cv-heading">Skills</h2>
        <dl class="space-y-4">
          {
            personalInfo.skillCategories.map((category) => (
              <div>
                <dt class="mb-1.5 font-medium">{category.name}</dt>
                <dd>
                  <ul class="flex flex-wrap gap-1.5">
                    {category.skills.map((skill) => <li class="chip">{skill}</li>)}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="cv-row" aria-labelledby="cv-languages">
        <h2 id="cv-languages" class="cv-heading">Languages</h2>
        <dl class="grid max-w-[24rem] grid-cols-[auto_1fr] gap-x-8 gap-y-1.5">
          {
            personalInfo.languages.map((language) => (
              <Fragment>
                <dt class="font-medium">{language.name}</dt>
                <dd class="text-muted">{language.level}</dd>
              </Fragment>
            ))
          }
        </dl>
      </section>
    </div>
  </div>
</Layout>

<style>
  .cv-row {
    display: grid;
    gap: 0.75rem 2rem;
    padding: 1.5rem 1.25rem;
  }

  .cv-heading {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  @media (min-width: 768px) {
    .cv-row {
      grid-template-columns: 11rem minmax(0, 1fr);
      padding: 2rem 1.75rem;
    }
  }
</style>
