---
import Layout from './Layout.astro';
import Icon from '../components/Icon.astro';

export interface Props {
  frontmatter: {
    title: string;
    description: string;
    organization: string;
    date: string;
    certificate?: string;
    image?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | Awards`} description={frontmatter.description}>
  <article class="page max-w-[52rem] pb-16 pt-10 sm:pb-24 sm:pt-16">
    <a href="/awards" class="text-link text-[0.9375rem]">
      <Icon name="arrow-left" size={16} />
      All awards
    </a>

    <h1 class="mt-6 text-[2.25rem] leading-[1.1] sm:text-[3rem]">{frontmatter.title}</h1>
    <p class="mt-2 font-medium">{frontmatter.organization}</p>
    <p class="text-muted">{frontmatter.date}</p>

    {
      frontmatter.image && (
        <div class="mt-8 overflow-hidden rounded-lg border border-line bg-sunken">
          <img src={frontmatter.image} alt="" class="w-full object-cover" />
        </div>
      )
    }

    <div class="mt-8 max-w-[44rem] space-y-4 leading-relaxed">
      <p>{frontmatter.description}</p>
      <slot />
    </div>

    {
      frontmatter.certificate && (
        <a href={encodeURI(frontmatter.certificate)} target="_blank" rel="noopener noreferrer" class="btn-primary mt-10">
          <Icon name="file-text" size={16} />
          View certificate
        </a>
      )
    }
  </article>
</Layout>
