---
import Layout from './Layout.astro';
import Icon from '../components/Icon.astro';

export interface Props {
  frontmatter: {
    title: string;
    description: string;
    image: string;
    technologies: string[];
    date: string;
    github?: string;
    demo?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | Projects`} description={frontmatter.description}>
  <article class="page max-w-[52rem] pb-16 pt-10 sm:pb-24 sm:pt-16">
    <a href="/projects" class="text-link text-[0.9375rem]">
      <Icon name="arrow-left" size={16} />
      All projects
    </a>

    <h1 class="mt-6 text-[2.25rem] leading-[1.1] sm:text-[3rem]">{frontmatter.title}</h1>
    <p class="mt-2 text-muted">{frontmatter.date}</p>

    <ul class="mt-4 flex flex-wrap gap-1.5">
      {frontmatter.technologies.map((tech) => <li class="chip">{tech}</li>)}
    </ul>

    <div class="mt-8 overflow-hidden rounded-lg border border-line bg-sunken">
      <img src={frontmatter.image} alt="" class="aspect-[16/10] w-full object-cover" />
    </div>

    <div class="mt-8 max-w-[44rem] space-y-4 leading-relaxed">
      <slot />
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      {
        frontmatter.github && (
          <a href={frontmatter.github} target="_blank" rel="noopener noreferrer" class="btn-primary">
            <Icon name="github" size={16} />
            Code
          </a>
        )
      }
      {
        frontmatter.demo && (
          <a href={frontmatter.demo} target="_blank" rel="noopener noreferrer" class="btn-secondary">
            <Icon name="external-link" size={16} />
            Live demo
          </a>
        )
      }
    </div>
  </article>
</Layout>
